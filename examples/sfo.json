{
  "version": 1,
  "title": "SFO",
  "status_bar": {
    "clock_format": "%H:%M",
    "show_battery": true,
    "show_network": true
  },
  "layout": {
    "columns": 3
  },
  "buttons": [
    {
      "id": "plan",
      "label": "Plan",
      "icon": "mark-location-symbolic",
      "description": "Mission planning",
      "action": {
        "kind": "givc-app",
        "vm": "flatpak-vm",
        "app": "run-flatpak-app",
        "args": ["http://org.example.Plan"],
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      },
      "icon_size": 58
    },
    {
      "id": "launch",
      "label": "Launch",
      "icon": "media-playback-start-symbolic",
      "action": {
        "kind": "givc-app",
        "vm": "flatpak-vm",
        "app": "run-flatpak-app",
        "args": ["http://org.example.Launch"],
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      },
      "icon_size": 50
    },
    {
      "id": "clear",
      "label": "Clear",
      "icon": "user-trash-symbolic",
      "description": "Delete working files",
      "action": {
        "kind": "givc-service",
        "vm": "flatpak-vm",
        "app": "sfo-clear.service",
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      },
      "icon_size": 54
    }
  ],
  "corners": [
    {
      "position": "bottom-left",
      "label": "Network",
      "icon": "network-wireless-symbolic",
      "action": {
        "kind": "exec",
        "argv": ["cosmic-settings", "network"]
      },
      "icon_size": 50
    },
    {
      "position": "bottom-center",
      "label": "Update Apps",
      "icon": "folder-download-symbolic",
      "action": {
        "kind": "givc-app",
        "vm": "flatpak-vm",
        "app": "sfo-update-apps",
        "await_completion": true,
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      },
      "icon_size": 48
    },
    {
      "position": "bottom-right",
      "label": "Power",
      "icon": "system-shutdown-symbolic",
      "action": {
        "kind": "exec",
        "argv": ["cosmic-applet-power"]
      },
      "icon_size": 46
    }
  ],
  "exit": {
    "label": "Exit kiosk",
    "icon": "window-close-symbolic"
  }
}
