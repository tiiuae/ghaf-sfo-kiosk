{
  "version": 1,
  "title": "SFO",
  "status_bar": {
    "clock_format": "%H:%M",
    "show_battery": true,
    "show_network": true
  },
  "layout": { "columns": 3 },
  "buttons": [
    {
      "id": "plan",
      "label": "Plan",
      "icon": "map-symbolic",
      "description": "Mission planning",
      "action": {
        "kind": "givc-app",
        "vm": "flatpak-vm",
        "app": "run-flatpak-app",
        "args": ["http://org.example.Plan"],
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      }
    },
    {
      "id": "launch",
      "label": "Launch",
      "icon": "media-playback-start-symbolic",
      "action": {
        "kind": "givc-app",
        "vm": "flatpak-vm",
        "app": "run-flatpak-app",
        "args": ["http://org.example.Launch"],
        "single_instance": true,
        "window_app_id": "Example Launcher Window",
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      }
    },
    {
      "id": "clear",
      "label": "Clear",
      "icon": "edit-clear-all-symbolic",
      "description": "Delete working files",
      "confirm": {
        "message": "Delete all mission working files?",
        "detail": "Plans and the Mission Planner autosave will be permanently removed."
      },
      "action": {
        "kind": "givc-service",
        "vm": "flatpak-vm",
        "app": "sfo-clear.service",
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      }
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "emblem-system-symbolic",
      "description": "Network, updates and power",
      "action": { "kind": "menu" }
    },
    {
      "id": "network",
      "label": "Network",
      "icon": "network-wireless-symbolic",
      "menu": "settings",
      "action": { "kind": "exec", "argv": ["cosmic-settings", "network"] }
    },
    {
      "id": "update",
      "label": "Update Apps",
      "icon": "software-update-available-symbolic",
      "description": "Install newer applications from the SSD",
      "menu": "settings",
      "action": {
        "kind": "givc-app",
        "vm": "flatpak-vm",
        "app": "sfo-update-apps",
        "await_completion": true,
        "givc_cli": [
          "/run/current-system/sw/bin/givc-cli",
          "--name",
          "admin-vm"
        ]
      }
    },
    {
      "id": "power",
      "label": "Power",
      "icon": "system-shutdown-symbolic",
      "description": "Lock, log out, restart or shut down",
      "menu": "settings",
      "action": { "kind": "exec", "argv": ["cosmic-applet-power"] }
    }
  ]
}
